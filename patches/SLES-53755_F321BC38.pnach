[Sprint Hector x1.6]
author=Jarkkovich
description=After running for 2 seconds Hector gradually speeds up to x1.6 without speeding up the animation. Enable only one Sprint patch. Based on the Speed Patch PPF idea.
// Movement function 0x46DD60 computes distance = f12 * time scale. Code cave 0xFFB00 multiplies it by the factor at 0xFFF10 only for Hector (time block 0x31A200)
// Counter 0xFFF00 counts frames while running (state 0xB066E4 = 0xF). Ramp after 2.0 s x1.2 / 2.13 s x1.4 / 2.27 s x1.6
patch=1,EE,E002000F,extended,10B066E4
patch=1,EE,200FFF10,extended,3F800000
patch=1,EE,100FFF00,extended,00000000
patch=1,EE,D0B066E4,extended,0000000F
