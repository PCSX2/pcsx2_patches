patch=1,EE,00380916,extended,88 // L2
patch=1,EE,0038091A,extended,8F // R2
patch=1,EE,0038090E,extended,8B // L1
patch=1,EE,00380912,extended,8C // R1
patch=1,EE,00380906,extended,89 // Cross
patch=1,EE,0038090A,extended,8A // Square

[Remapped triggers\Square-Cross shifting]
author=Silent
description=Maps throttle/brake to triggers, downshift/upshift to Square/Cross. (like in GT7)
