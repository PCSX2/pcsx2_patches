[Restore Quick Select]
author=Crashz
description=Restore the gadget quick select feature that existed in the Japanese release but was removed for NTSC
// The if statement used in the original GQS functionality was left in but the 
// scope of code was presumably IFDEF'd out to only return 1. 
// We can leverage this redundant if statement to patch in a jump to a code 
// cave mimicking the original GQS functionality. 
patch=1,EE,202B4B10,extended,0C115FC0
patch=1,EE,202B4B14,extended,00000000

// Code Cave 1 - Mimic if statement check for if gadget button was pressed twice
patch=1,EE,20457F00,extended,64010001
patch=1,EE,20457F04,extended,1201000E // Branch Equals, jump to GQS Code Cave
patch=1,EE,20457F08,extended,00000000
patch=1,EE,20457F0C,extended,080AD2C6 // Not GQS action, return to original code
patch=1,EE,20457F10,extended,00000000

